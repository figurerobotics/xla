module(
    name = "xla",
    version = "0.1.0",
)

bazel_dep(name = "bazel_skylib", version = "1.4.0")
bazel_dep(name = "platforms", version = "0.0.10")
bazel_dep(name = "rules_cc", version = "0.1.1")

#bazel_dep(name = "rules_cuda", version = "0.2.1")

json_init = use_extension("@xla//:json_init_extension.bzl", "json_init")
use_repo(
    json_init,
    "cuda_redist_json",
)

redist_config = use_extension("@xla//:redist_extension.bzl", "redist_config")
use_repo(
    redist_config,
    "cuda_cccl",
    "cuda_cublas",
    "cuda_cudart",
    "cuda_cudnn",
    "cuda_cufft",
    "cuda_cupti",
    "cuda_curand",
    "cuda_cusolver",
    "cuda_cusparse",
    "cuda_nvdisasm",
    "cuda_nvjitlink",
    "cuda_nvml",
    "cuda_nvtx",
    "cuda_nvcc",
    "cuda_npp",
    "cuda_nvjpeg",
)

hermetic_cuda = use_extension("@xla//:extensions.bzl", "hermetic_cuda")
use_repo(
    hermetic_cuda,
    "local_config_cuda",
)
